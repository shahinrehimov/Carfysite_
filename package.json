{
  "name": "carfy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:all": "concurrently -n carfy,admin,company -c blue,green,magenta \"npm run dev\" \"npm run dev --prefix ../carfy_admin\" \"npm run dev --prefix ../carfy_company\"",
    "install:all": "concurrently -n carfy,admin,company \"npm install\" \"npm install --prefix ../carfy_admin\" \"npm install --prefix ../carfy_company\"",
    "pull:all": "concurrently -n carfy,admin,company \"git pull\" \"git -C ../carfy_admin pull\" \"git -C ../carfy_company pull\"",
    "dev": "next dev",
    "build": "rm -rf .next && next build && npm run copy-static-files",
    "start": "next start",
    "format": "prettier --write .",
    "copy-static-files": "cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "github:fancyapps/ui",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^2.11.2",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookies-next": "^6.1.1",
    "dayjs": "^1.11.18",
    "framer-motion": "^12.23.24",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "next": "^16.0.10",
    "next-intl": "^4.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.68.0",
    "react-leaflet": "^5.0.0",
    "react-redux": "^9.2.0",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.3.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.14",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}